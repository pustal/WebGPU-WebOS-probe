 namespace dawn::native::opengl {
 
+#if defined(DAWN_USE_WAYLAND)
+namespace {
+
+// libwayland-egl entry points, loaded at run time so Dawn does not link against Wayland.
+struct WaylandEGLFunctions {
+    void* (*windowCreate)(void* surface, int width, int height) = nullptr;
+    void (*windowDestroy)(void* window) = nullptr;
+    void (*windowResize)(void* window, int width, int height, int dx, int dy) = nullptr;
+};
+
+// Returns the loaded functions, or nullptr if libwayland-egl is unavailable.
+const WaylandEGLFunctions* GetWaylandEGLFunctions() {
+    static const WaylandEGLFunctions* functions = []() -> const WaylandEGLFunctions* {
+        void* lib = dlopen("libwayland-egl.so.1", RTLD_NOW | RTLD_LOCAL);
+        if (lib == nullptr) {
+            lib = dlopen("libwayland-egl.so", RTLD_NOW | RTLD_LOCAL);
+        }
+        if (lib == nullptr) {
+            return nullptr;
+        }
+        static WaylandEGLFunctions loaded;
+        loaded.windowCreate = reinterpret_cast<decltype(loaded.windowCreate)>(
+            dlsym(lib, "wl_egl_window_create"));
+        loaded.windowDestroy = reinterpret_cast<decltype(loaded.windowDestroy)>(
+            dlsym(lib, "wl_egl_window_destroy"));
+        loaded.windowResize = reinterpret_cast<decltype(loaded.windowResize)>(
+            dlsym(lib, "wl_egl_window_resize"));
+        if (!loaded.windowCreate || !loaded.windowDestroy || !loaded.windowResize) {
+            return nullptr;
+        }
+        return &loaded;
+    }();
+    return functions;
+}
+
+}  // namespace
